# Copy to `.env` for local overrides, or set in the Vercel dashboard.

# Base URL of the backend API (no trailing slash, no "/api" suffix).
# Leave empty for local dev — Vite proxies /api to http://localhost:8000.
# In production set it to your Render backend URL, e.g.:
#   VITE_API_URL=https://docuquery-backend.onrender.com
VITE_API_URL=
