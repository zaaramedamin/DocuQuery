# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file.

# Hugging Face User Access Token (Required)
HF_TOKEN=hf_your_token_here

# Supabase Credentials (Required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Optional ──────────────────────────────────────────────────────
# Chat model (must be served by a provider your HF token can access —
# see https://huggingface.co/settings/inference-providers).
# Default: meta-llama/Llama-3.1-8B-Instruct
# GENERATION_MODEL=Qwen/Qwen2.5-72B-Instruct

# Comma-separated list of allowed CORS origins (use your frontend URL in production)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Maximum PDF upload size in megabytes (default: 25)
# MAX_UPLOAD_MB=25
