# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file.

# Google AI Studio API key (required) — free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase credentials (required). SUPABASE_KEY must be the service_role / secret key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Optional ──────────────────────────────────────────────────────
# Chat model (default: gemini-3.5-flash-lite)
# GENERATION_MODEL=gemini-3.5-flash-lite

# Your frontend URL: CORS allow-list and where password-reset emails link back to
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# FRONTEND_URL=https://your-frontend.vercel.app

# Pro plan is a demo (no payment): true lets users switch to Pro, false switches it off
# BILLING_DEMO_MODE=true

# Free plan limits (see the README for every setting)
# MAX_UPLOAD_MB=10
# MAX_DOCS_PER_USER=25
# DAILY_QUERY_LIMIT=200
